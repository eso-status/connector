{
  "name": "@eso-status/connector",
  "version": "2.2.2",
  "description": "Connector for eso-status api",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "build": "rm -f index.js index.d.ts && tsc --project tsconfig.build.json",
    "dev": "npm run build && node .",
    "watch": "nodemon --exec npm run dev",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch",
    "test:cov": "jest --runInBand --coverage"
  },
  "files": [
    ".npmrc",
    "index.d.ts",
    "index.js",
    "LICENSE.md",
    "package.json",
    "README.md"
  ],
  "engineStrict": true,
  "engines": {
    "node": "^18.18.0 || >=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eso-status/connector.git"
  },
  "author": "@dov118 <contact@dov118.dev> (https://dov118.dev)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eso-status/connector/issues"
  },
  "homepage": "https://github.com/eso-status/connector#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "moment": "2.31.0",
    "nodemon": "3.1.14",
    "prettier": "3.10.1",
    "socket.io": "4.8.4",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "dependencies": {
    "@eso-status/types": "1.0.9",
    "axios": "1.21.1",
    "socket.io-client": "4.8.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.e2e-spec\\.ts|.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "modulePaths": [
      "<rootDir>"
    ]
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1",
    "glob@>=9.0.0 <=14.0.1": "14.0.2"
  }
}
